{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "MasterGuard AI Web — Guided Debug",
      "type": "debugpy",
      "request": "launch",
      "module": "app.server",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "subProcess": false,
      "env": {
        "FLASK_DEBUG": "0",
        "SENTINELLOOP_TRACE": "1",
        "PYTHONUNBUFFERED": "1"
      }
    }
  ]
}
