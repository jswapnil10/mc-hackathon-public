      "genai_role": [
        "Improves impersonation consistency in the pre-transaction phase",
        "Scales targeting and pretext variation",
        "Adapts observable transaction timing after defensive feedback"
      ],
      "payment_surface": [
        "ONLINE_BANKING",
        "MOBILE_BANKING",
        "REAL_TIME_TRANSFER"
      ],
      "source_refs": [
