{
  "catalog_version": "1.0",
  "catalog_purpose": "Curated defensive attack cards for synthetic payment-security simulations only.",
  "cards": [
    {
      "attack_family": "APP-01",
      "name": "GenAI-amplified authorized push payment scam",
      "observed_pattern": "A victim is manipulated into authorizing a payment to a newly introduced beneficiary. GenAI can increase personalization, language quality, channel consistency, and campaign scale, while the simulator represents only defensive metadata and payment behavior.",
      "genai_role": [
        "Personalizes social-engineering themes at scale",
        "Maintains consistent personas across simulated channels",
        "Adapts urgency and pretext categories without generating message content"
      ],
      "payment_surface": [
        "REAL_TIME_ACCOUNT_TO_ACCOUNT",
        "MOBILE_BANKING",
        "UPI_LIKE_PUSH_PAYMENT"
      ],
      "source_refs": [
        {
          "title": "Mastercard — Generative AI: Preparing Your Fraud Organization",
          "url": "https://www.mastercard.com/us/en/business/cybersecurity-fraud-prevention/cybersecurity/generative-ai-report.html",
          "observed": "GenAI changes both fraud enablement and fraud defense across the user transaction journey."
        },
        {
          "title": "FinCEN Alert on Fraud Schemes Involving Deepfake Media",
          "url": "https://www.fincen.gov/system/files/shared/FinCEN-Alert-DeepFakes-Alert508FINAL.pdf",
          "observed": "FinCEN identifies authorized push payment fraud among schemes associated with GenAI-enabled identities."
        }
      ],
      "stage_templates": [
        {
          "stage_id": "persuasion_context",
          "event_type": "COMMUNICATION_RISK_CONTEXT",
          "offset_seconds": 0,
          "blue_intervention_point": "PREVENT",
          "observable_signals": [
            "declared_urgency_band",
            "channel_switch_count",
            "first_contact_recency"
          ],
          "attributes": {
            "sender_account_id": "$synthetic.sender",
            "urgency_level": "$param.urgency_level",
            "channel_switch_count": "$param.channel_switch_count",
            "content_available": false
          }
        },
        {
          "stage_id": "new_beneficiary",
          "event_type": "BENEFICIARY_ADDED",
          "offset_seconds": 45,
          "blue_intervention_point": "PREVENT",
          "observable_signals": [
            "beneficiary_age_days",
            "beneficiary_first_seen"
          ],
          "attributes": {
            "sender_account_id": "$synthetic.sender",
            "beneficiary_id": "$synthetic.beneficiary",
            "beneficiary_age_days": "$param.beneficiary_age_days"
          }
        },
        {
          "stage_id": "authorized_payment",
          "event_type": "PAYMENT_INITIATED",
          "offset_seconds": 120,
          "blue_intervention_point": "DECIDE",
          "observable_signals": [
            "amount_vs_sender_baseline",
            "beneficiary_novelty",
            "recent_contact_risk"
          ],
          "attributes": {
            "sender_account_id": "$synthetic.sender",
            "beneficiary_id": "$synthetic.beneficiary",
            "device_id": "$synthetic.device",
            "amount_multiplier": "$param.amount_multiplier",
            "customer_authorized": true
          }
        },
        {
          "stage_id": "payment_follow_up",
          "event_type": "PAYMENT_REPEATED",
          "offset_seconds": 300,
          "blue_intervention_point": "DECIDE",
          "observable_signals": [
            "repeat_payment_count",
            "short_payment_interval"
          ],
          "attributes": {
            "sender_account_id": "$synthetic.sender",
            "beneficiary_id": "$synthetic.beneficiary",
            "payment_count": "$param.payment_count",
            "payment_interval_minutes": "$param.payment_interval_minutes"
          }
        },
        {
          "stage_id": "beneficiary_receipt",
          "event_type": "FUNDS_RECEIVED",
          "offset_seconds": 600,
          "blue_intervention_point": "CONTAIN",
          "observable_signals": [
            "new_payee_value_received",
