# One OpenAI-compatible endpoint can economically serve both isolated roles.
MODEL_BASE_URL=http://127.0.0.1:8000/v1
MODEL_API_KEY=replace-with-a-private-random-value
RED_MODEL_ID=Qwen/Qwen3.5-9B
BLUE_MODEL_ID=Qwen/Qwen3.5-9B

# vLLM supports strict JSON-schema output. Use json_object or prompt only for
# a model server that does not implement response_format=json_schema.
MODEL_STRUCTURED_OUTPUT_MODE=json_schema
# Prevent Qwen thinking tokens from consuming the structured JSON output budget.
MODEL_REASONING_EFFORT=none
MODEL_TIMEOUT_SECONDS=120
MODEL_MAX_OUTPUT_TOKENS=1400
CASE_PARALLELISM=4
RED_AGENT_TEMPERATURE=0.65
BLUE_AGENT_TEMPERATURE=0.15

# Blue-only two-speed defense. Train the champion with scripts/train_detector.py first.
# Red never receives detector scores, features, thresholds, or model files.
ML_DETECTOR_ENABLED=1
ML_MODEL_DIR=data/loop/models/champion

# Every completed Referee round can append post-outcome learning rows. Retraining is
# intentionally off in the fast UI path; enable it explicitly for a multi-round learning demo.
BATTLE_TRAINING_LOG=data/loop/training_log.jsonl
BATTLE_RETRAIN_EVERY=0
BATTLE_INCLUDE_AMBIENT=0
BATTLE_AMBIENT_SAMPLE=8
BATTLE_TRAP_SAMPLE_EACH=2

# Public web process
APP_HOST=0.0.0.0
PORT=8501
FLASK_DEBUG=0
SENTINELLOOP_TRACE=0
