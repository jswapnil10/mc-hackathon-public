# One OpenAI-compatible endpoint can economically serve both isolated roles.
MODEL_BASE_URL=http://127.0.0.1:8000/v1
MODEL_API_KEY=replace-with-a-private-random-value
RED_MODEL_ID=Qwen/Qwen3.5-9B
BLUE_MODEL_ID=Qwen/Qwen3.5-9B

# vLLM supports strict JSON-schema output. Use json_object or prompt only for
# a model server that does not implement response_format=json_schema.
MODEL_STRUCTURED_OUTPUT_MODE=json_schema
MODEL_TIMEOUT_SECONDS=600
MODEL_MAX_OUTPUT_TOKENS=1400
CASE_PARALLELISM=4
RED_AGENT_TEMPERATURE=0.65
BLUE_AGENT_TEMPERATURE=0.15

# Public web process
APP_HOST=0.0.0.0
PORT=8501
FLASK_DEBUG=0
SENTINELLOOP_TRACE=0
