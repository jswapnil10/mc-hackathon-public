# One OpenAI-compatible endpoint can economically serve both isolated roles.
MODEL_BASE_URL=http://127.0.0.1:8000/v1
MODEL_API_KEY=replace-with-a-private-random-value
RED_MODEL_ID=Qwen/Qwen3.5-9B
BLUE_MODEL_ID=Qwen/Qwen3.5-9B

# vLLM supports strict JSON-schema output. Use json_object or prompt only for
# a model server that does not implement response_format=json_schema.
MODEL_STRUCTURED_OUTPUT_MODE=json_schema
# Set to claude when the provider needs Claude-specific strict JSON and
# completeness guidance; leave generic for Qwen and other compatible models.
MODEL_PROMPT_PROFILE=generic
# Direct structured generation keeps Qwen/Ollama responsive. If a server rejects the optional
# reasoning_effort field entirely, the gateway automatically retries without that field.
MODEL_REASONING_EFFORT=none
MODEL_TIMEOUT_SECONDS=120
# Optional hidden reasoning is stopped after this many seconds so direct structured
# generation can use the remainder of MODEL_TIMEOUT_SECONDS.
MODEL_REASONING_ATTEMPT_TIMEOUT_SECONDS=45
MODEL_MAX_OUTPUT_TOKENS=1400
CASE_PARALLELISM=2
RED_AGENT_TEMPERATURE=0.65
BLUE_AGENT_TEMPERATURE=0.15

# Blue-only two-speed defense. A frozen champion is shipped for clean-checkout demos; retrain it
# with scripts/train_detector.py when the feature contract or supported sklearn version changes.
# Red never receives detector scores, features, thresholds, or model files.
ML_DETECTOR_ENABLED=1
ML_MODEL_DIR=data/loop/models/champion

# Every completed Referee round appends post-outcome learning rows. The web app returns the battle
# report first, then retrains in one background worker every five successful battles. Set 0 to
# disable. BATTLE_RETRAIN_EVERY is a separate synchronous mode for controlled CLI experiments;
# configure only one cadence at a time.
BATTLE_TRAINING_LOG=data/loop/training_log.jsonl
RETRAIN_EVERY_BATTLES=5
BATTLE_RETRAIN_EVERY=0
BATTLE_INCLUDE_AMBIENT=0
BATTLE_AMBIENT_SAMPLE=8
BATTLE_TRAP_SAMPLE_EACH=2

# Public web process
APP_HOST=0.0.0.0
PORT=8501
FLASK_DEBUG=0
SENTINELLOOP_TRACE=0
